<Window x:Class="Dolgozatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dolgozatok"
        mc:Ignorable="d"
        Title="Dolgozatok" Height="350" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <DataGrid Margin="10" Grid.Row="0" x:Name="dg"/>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="1">
            <Label Margin="10" Content="Név: "/>
            <TextBox x:Name="nev" Margin="10" Width="100" Height="20"/>
            <Label Margin="10" Content="Életkor: "/>
            <TextBox x:Name="kor" Margin="10" Width="50" Height="20"/>
            <Label Margin="10" Content="Pontszám: "/>
            <TextBox x:Name="pont" Margin="10" Width="50" Height="20"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Margin="10" Width="75" Height="20" Content="Hozzáadás" Click="Hozzaad"/>
            <Button Margin="10" Width="75" Height="20" Content="Mentés" Click="Mentes"/>
        </StackPanel>
    </Grid>
</Window>
